# Base de datos: postgres | mysql | mongo
DB_ENGINE=postgres

# Conexión SQL (postgres / mysql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hardboiled_db
DB_USER=hardboiled
DB_PASSWORD=changeme

# Conexión MongoDB (si DB_ENGINE=mongo)
# MONGO_URI=mongodb://localhost:27017/hardboiled_db

# Conector de IA: ollama | claude | gemini | chatgpt
AI_CONNECTOR=ollama

# Ollama (por defecto, sin API key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=hecate:latest

# Claude (Anthropic) — descomentar y rellenar si AI_CONNECTOR=claude
# CLAUDE_API_KEY=
# CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5

# Gemini (Google) — descomentar y rellenar si AI_CONNECTOR=gemini
# GEMINI_API_KEY=
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# ChatGPT (OpenAI) — descomentar y rellenar si AI_CONNECTOR=chatgpt
# OPENAI_API_KEY=
# OPENAI_DEFAULT_MODEL=gpt-4o

# Streaming de respuestas de IA
STREAM_DEFAULT=true